# ============================================================================
# PARKWISE — Enterprise Smart Parking Platform Environment Configuration
# Copy this file to .env and fill in real credentials for production deployment
# ============================================================================

# --- Application Environment ---
ENVIRONMENT=development
APP_NAME=Parkwise Enterprise Smart Parking Platform
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Database (PostgreSQL in Production / SQLite Fallback for Local Dev) ---
# Production PostgreSQL example:
# DATABASE_URL=postgresql+psycopg2://parkwise_user:parkwise_secret@localhost:5432/parkwise_db
DATABASE_URL=sqlite:///./parkwise.db

# --- Caching & Distributed Slot Concurrency Lock (Redis) ---
REDIS_URL=redis://localhost:6379/0
SLOT_LOCK_TTL_SECONDS=300

# --- Security, JWT & Cryptographic Signing ---
JWT_SECRET_KEY=replace-with-64-byte-high-entropy-production-jwt-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
QR_HMAC_SECRET=replace-with-production-qr-gate-verification-hmac-secret

# --- Razorpay Payment Gateway (India) ---
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_webhook_placeholder_secret
PAYMENT_SIMULATION_MODE=true

# --- AI & ML Engine Configuration ---
AI_DYNAMIC_PRICING_ENABLED=true
AI_SURGE_MAX_MULTIPLIER=2.25
AI_ANPR_MIN_CONFIDENCE=0.88
OPENAI_API_KEY=

# --- Frontend Public Variables ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/telemetry
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
