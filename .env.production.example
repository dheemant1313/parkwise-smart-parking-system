# ==============================================================================
# PARKWISE ENTERPRISE PRODUCTION ENVIRONMENT CONFIGURATION
# Copy to .env.production on target server and populate production secrets.
# NEVER commit real credentials to public source repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION & ENVIRONMENT
# ------------------------------------------------------------------------------
APP_NAME="Parkwise Smart Parking System"
ENVIRONMENT=production
DEBUG=False
LOG_LEVEL=INFO
ALLOWED_HOSTS=parkwise.in,www.parkwise.in,api.parkwise.in

# ------------------------------------------------------------------------------
# 2. CORS & TRUSTED ORIGINS
# ------------------------------------------------------------------------------
CORS_ORIGINS=https://parkwise.in,https://www.parkwise.in,https://api.parkwise.in
COOKIE_DOMAIN=parkwise.in
COOKIE_SECURE=True
COOKIE_SAMESITE=lax
COOKIE_HTTPONLY=True

# ------------------------------------------------------------------------------
# 3. DATABASE (POSTGRESQL 16 ENTERPRISE)
# ------------------------------------------------------------------------------
POSTGRES_USER=parkwise_admin
POSTGRES_PASSWORD=CHANGE_ME_SUPER_STRONG_POSTGRES_PASSWORD_2026
POSTGRES_DB=parkwise_production
DATABASE_URL=postgresql+psycopg2://parkwise_admin:CHANGE_ME_SUPER_STRONG_POSTGRES_PASSWORD_2026@postgres:5432/parkwise_production
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# ------------------------------------------------------------------------------
# 4. REDIS 7 IN-MEMORY CACHE & CONCURRENCY LOCK ENGINE
# ------------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_REDIS_STRONG_AUTH_TOKEN_2026
REDIS_URL=redis://:CHANGE_ME_REDIS_STRONG_AUTH_TOKEN_2026@redis:6379/0
REDIS_LOCK_TTL_SECONDS=15
REDIS_RESERVATION_HOLD_MINUTES=10

# ------------------------------------------------------------------------------
# 5. CRYPTOGRAPHIC SECRETS & TOKENS
# ------------------------------------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=CHANGE_ME_64_CHAR_HEX_CRYPTOGRAPHIC_JWT_KEY_PROD
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=30

# Gate QR Pass HMAC Signature Secret (Tamper Resistance)
# Generate with: openssl rand -hex 32
QR_HMAC_SECRET=CHANGE_ME_64_CHAR_HEX_QR_GATE_HMAC_SECRET_PROD
QR_PASS_TTL_MINUTES=60

# ------------------------------------------------------------------------------
# 6. PAYMENT GATEWAYS (RAZORPAY INDIA)
# ------------------------------------------------------------------------------
PAYMENT_SIMULATION_MODE=False
RAZORPAY_KEY_ID=rzp_live_PROD_KEY_ID_HERE
RAZORPAY_KEY_SECRET=PROD_RAZORPAY_KEY_SECRET_HERE
RAZORPAY_WEBHOOK_SECRET=PROD_RAZORPAY_WEBHOOK_SECRET_HERE
CURRENCY=INR
GST_PERCENTAGE=18.0

# ------------------------------------------------------------------------------
# 7. NOTIFICATIONS & EXTERNAL TELEMETRY
# ------------------------------------------------------------------------------
# WhatsApp Cloud API (Meta Business Platform)
# Requires Meta Business Verification & System User Access Token
WHATSAPP_ENABLED=False
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_TOKEN=

# SMS Gateway (Twilio / Fast2SMS / MSG91)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ------------------------------------------------------------------------------
# 8. DPDP ACT 2023 & PRIVACY COMPLIANCE
# ------------------------------------------------------------------------------
DPDP_DATA_CONTROLLER="Parkwise Technologies India Pvt. Ltd."
DPDP_DPO_CONTACT="privacy@parkwise.in"
DPDP_PII_LOG_MASKING=True
AUDIT_LOG_RETENTION_DAYS=730

# ------------------------------------------------------------------------------
# 9. MONITORING, TELEMETRY & APM
# ------------------------------------------------------------------------------
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_METRICS=True
PROMETHEUS_METRICS_PORT=9090
